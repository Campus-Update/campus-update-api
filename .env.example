POSTGRES_DB=campus_update
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
JWT_KEY=replace-with-at-least-32-random-characters

# Backblaze B2 media storage. Keep application keys in a secret store.
B2__Endpoint=https://s3.REGION.backblazeb2.com
B2__Region=REGION
B2__BucketName=BUCKET_NAME
B2__KeyId=SET_IN_SECRET_STORE
B2__ApplicationKey=SET_IN_SECRET_STORE
B2__PublicBaseUrl=https://f005.backblazeb2.com/file/BUCKET_NAME

