FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY src/CampusUpdate.Domain/CampusUpdate.Domain.csproj src/CampusUpdate.Domain/
COPY src/CampusUpdate.Infrastructure/CampusUpdate.Infrastructure.csproj src/CampusUpdate.Infrastructure/
COPY src/CampusUpdate.Api/CampusUpdate.Api.csproj src/CampusUpdate.Api/
RUN dotnet restore src/CampusUpdate.Api/CampusUpdate.Api.csproj
COPY src/ src/
RUN dotnet publish src/CampusUpdate.Api/CampusUpdate.Api.csproj -c Release -o /app --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_ENVIRONMENT=Production
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "CampusUpdate.Api.dll"]
