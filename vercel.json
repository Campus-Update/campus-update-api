{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "api" } }
  ],
  "crons": [
    { "path": "/api/v1/internal/notifications/retry", "schedule": "*/5 * * * *" }
  ]
}
